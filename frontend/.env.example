# ARVANA Environment Variables Example
# Copy this file to .env.local and fill in your values

# API Configuration (if using backend)
# VITE_API_URL=https://api.arvana.com

# Analytics (optional)
# VITE_ANALYTICS_ID=your-analytics-id

# Feature Flags
# VITE_ENABLE_SOCIAL_SHARE=true
# VITE_ENABLE_PRODUCT_RECOMMENDATIONS=true

# Camera Settings
# VITE_DEFAULT_CAMERA_RESOLUTION=720
# VITE_MAX_CAMERA_RESOLUTION=1080
